(async()=>{
 browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--no-sandbox']});
 await check('Market deleted lists and their unfinished purchase details synchronize and restore on the other device',async()=>{const a=await setupDevice(),b=await setupDevice();try{await pair(a,b);await a.p.evaluate(()=>{const m=__review.getMarketState();m.activeLists.push({id:'recycle-list',status:'active',supplierId:null,createdAt:new Date().toISOString(),items:[{id:'recycle-item',productId:'shared-product',manualNew:false,purchase:{name:'Shared Product',productId:'shared-product',division:'essentials',totalUnits:3,cost:10,totalCost:30,sell:20,unitsPerPack:12,payment:'purchase_cash',updateOnly:false}}]});m.selectedActiveListId='recycle-list';m.active=m.activeLists.at(-1).items;__review.seedMarket(m)});await idle(a.p);await transfer(a,b);await a.p.evaluate(()=>__review.deleteMarketActiveList('recycle-list'));await idle(a.p);await exchange(a,b);const m=await b.p.evaluate(()=>__review.getMarketState());assert(m.deletedActiveLists.some(l=>l.id==='recycle-list'),'Deleted active list missing on receiving phone');assert.equal(m.deletedActiveLists.find(l=>l.id==='recycle-list').items[0].purchase.totalCost,30);await b.p.evaluate(()=>__review.restoreMarketActiveList('recycle-list'));await idle(b.p);await exchange(b,a);for(const d of [a,b])assert((await d.p.evaluate(()=>__review.getMarketState())).activeLists.some(l=>l.id==='recycle-list'));return{deletedListAndPurchasePreserved:true,restoredAcrossDevices:true}}finally{await a.c.close();await b.c.close()}});
 await check('Market session history and budget changes transfer without changing purchased stock or accounting',async()=>{const a=await setupDevice(),b=await setupDevice();try{await pair(a,b);await a.p.evaluate(()=>{const m=__review.getMarketState();m.budget=25000;m.sessions.push({id:'market-session-review',createdAt:new Date().toISOString(),name:'Completed market visit',total:1300,items:[]});__review.seedMarket(m)});await idle(a.p);await exchange(a,b);const m=await b.p.evaluate(()=>__review.getMarketState());assert(m.sessions.some(s=>s.id==='market-session-review'),'Market session history missing');assert.equal(m.budget,25000);assert.equal((await quantities(b.p)).stock[0].qty,50);return{sessionPreserved:true,budget:25000}}finally{await a.c.close();await b.c.close()}});
 await check('A later edit after receiving a high-sequence event is causally ordered without a false conflict',async()=>{const a=await setupDevice(),b=await setupDevice();try{await pair(a,b);await a.p.evaluate(async()=>{for(let i=0;i<15;i++){__review.seedNotes([{id:'causal-note',text:'revision '+i,savedAt:'2026-10-14T12:00:00Z'}]);await __review.idle()}});await transfer(a,b);await b.p.evaluate(()=>__review.seedNotes([{id:'causal-note',text:'edited after receiving all revisions',savedAt:'2026-10-14T12:00:00Z'}]));await idle(b.p);await authorize(b.p);const file=await b.p.evaluate(()=>RoseachySmartSync.updates()),payload=await readOn(a.p,file),plan=await a.p.evaluate(p=>RoseachySmartSync.planUpdates(p),payload);assert.deepEqual(plan.conflicts,[],'Sequential causal edit reported as concurrent conflict');await a.p.evaluate(p=>RoseachySmartSync.merge(p),payload);assert.equal(await a.p.evaluate(()=>__review.getNotes()[0].text),'edited after receiving all revisions');return{causalOrderPreserved:true,unnecessaryConflict:false}}finally{await a.c.close();await b.c.close()}});
 await check('A merge uses one atomic commit for records, event IDs and receipt metadata',async()=>{const a=await setupDevice(),b=await setupDevice();try{await pair(a,b);await desk(a.p,'sales');await nativePurchase(a.p,24);await authorize(a.p);const file=await a.p.evaluate(()=>RoseachySmartSync.updates()),payload=await readOn(b.p,file);await b.p.evaluate(()=>{window.syncStateWrites=0;window.origPut=IDBObjectStore.prototype.put;IDBObjectStore.prototype.put=function(...args){if(this.name==='synchronization'&&args[1]==='roseachy_sync_state_v1'){syncStateWrites++;if(syncStateWrites===2)throw new DOMException('Failure after first durable state write','AbortError')}return origPut.apply(this,args)}});await b.p.evaluate(p=>RoseachySmartSync.merge(p),payload);assert.equal(await b.p.evaluate(()=>syncStateWrites),1,'Merge split across durable commits');assert.equal((await quantities(b.p)).stock[0].qty,74);return{atomicStateWrites:1,stock:74}}finally{await b.p.evaluate(()=>{if(window.origPut)IDBObjectStore.prototype.put=origPut}).catch(()=>{});await a.c.close();await b.c.close()}});
 await check('An exhausted market advance rejects a larger purchase without partial stock, history or cash changes',async()=>{const a=await setupDevice(),b=await setupDevice();try{await pair(a,b);const id=await a.p.evaluate(()=>RoseachySmartSync.advance(100,'Market worker'));await a.p.evaluate(id=>RoseachySmartSync.setMarketOptions({advanceId:id,receiveNow:true}),id);await marketPurchase(a.p,{qty:8,total:80});const before=await quantities(a.p);await assert.rejects(()=>marketPurchase(a.p,{qty:3,total:30}),/Market purchase rejected/);const after=await quantities(a.p);assert.deepEqual(after.stock,before.stock);assert.deepEqual(after.tx,before.tx);assert.equal(after.calc.expectedCash,99900);assert.equal(await a.p.evaluate(id=>RoseachySmartSync.advanceBalance(id),id),20);return{partialPurchaseRejected:true,availableFunds:20}}finally{await a.c.close();await b.c.close()}});
 await check('Two devices spending the same advance retain purchases and flag the resulting funding shortage',async()=>{const a=await setupDevice(),b=await setupDevice();try{await pair(a,b);const id=await a.p.evaluate(()=>RoseachySmartSync.advance(100,'Shared purchasing advance'));await transfer(a,b);for(const d of [a,b]){await d.p.evaluate(id=>RoseachySmartSync.setMarketOptions({advanceId:id,receiveNow:true}),id);await marketPurchase(d.p,{qty:8,total:80})}const file=await a.p.evaluate(()=>RoseachySmartSync.updates()),payload=await readOn(b.p,file),plan=await b.p.evaluate(p=>RoseachySmartSync.planUpdates(p),payload);assert(plan.conflicts.some(x=>x.type==='market-advance-shortage'),'Overspent advance is absent from merge preview');await b.p.evaluate(p=>RoseachySmartSync.merge(p),payload);assert.equal(await b.p.evaluate(id=>RoseachySmartSync.advanceBalance(id),id),-60);assert.equal((await quantities(b.p)).sync.status,'Merge Conflict');return{deficit:60,bothPurchasesPreserved:true}}finally{await a.c.close();await b.c.close()}});
 await check('PIN session expiry displays an unlock form in the already-open Smart Sync screen',async()=>{const a=await setupDevice();try{await a.p.evaluate(()=>RoseachySmartSync.open());assert(await a.p.locator('#syncPanel').isVisible());await a.p.evaluate(()=>RoseachySmartSync.lock());assert(await a.p.locator('#syncGate').isVisible(),'Expired session leaves both panels hidden');await a.p.fill('#syncPin','1234');await a.p.click('#syncAuthorize');await a.p.waitForFunction(()=>!document.getElementById('syncPanel').classList.contains('hidden'));return{reauthorizationAvailable:true}}finally{await a.c.close()}});
 await check('Selected recipient exports only unacknowledged events and duplicate receipts do not add stock',async()=>{const a=await setupDevice(),b=await setupDevice();try{await pair(a,b);await desk(a.p,'sales');await nativePurchase(a.p,24);await exchange(a,b);await authorize(a.p);const target=await b.p.evaluate(()=>RoseachySmartSync.identity().deviceId),file=await a.p.evaluate(t=>RoseachySmartSync.updates(t),target),payload=await readOn(b.p,file);assert.equal(payload.events.length,0);await b.p.evaluate(p=>RoseachySmartSync.merge(p),payload);assert.equal((await quantities(b.p)).stock[0].qty,74);return{recipientMissingEvents:0,stock:74}}finally{await a.c.close();await b.c.close()}});
 await browser.close();fs.writeFileSync(root+'/tests/deep-review-results.json',JSON.stringify({results,errors,metrics},null,2));console.log(JSON.stringify({passed:results.filter(x=>x.passed).length,failed:results.filter(x=>!x.passed).length,errors}));if(results.some(x=>!x.passed)||errors.length)process.exitCode=1;
})().catch(async e=>{console.error(e.stack);fs.writeFileSync(root+'/tests/deep-review-results.json',JSON.stringify({results,errors,fatal:e.stack},null,2));if(browser)await browser.close();process.exit(1)});
